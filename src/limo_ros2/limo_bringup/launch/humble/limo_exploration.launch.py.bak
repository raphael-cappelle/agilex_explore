#!/usr/bin/python3
from launch import LaunchDescription
from launch.actions import IncludeLaunchDescription, DeclareLaunchArgument, GroupAction
from launch.launch_description_sources import PythonLaunchDescriptionSource
from launch_ros.actions import Node
from ament_index_python.packages import get_package_share_directory
from launch.substitutions import LaunchConfiguration
import os


def generate_launch_description():
    # === Chemins ===
    bringup_dir = get_package_share_directory('limo_bringup')
    slam_dir = get_package_share_directory('slam_toolbox')
    nav2_dir = get_package_share_directory('nav2_bringup')

    use_sim_time = LaunchConfiguration('use_sim_time')
    declared_arguments = [
        DeclareLaunchArgument('use_sim_time', default_value='false'),
    ]

    DeclareLaunchArgument(
        'map',
        default_value='',
        description='Aucune carte requise pour exploration autonome'
    )


    # === 1️⃣ Lancement du slam_toolbox (mode online async) ===
    slam_params_file = os.path.join(bringup_dir, 'config', 'slam_toolbox_config.yaml')

    slam_toolbox = IncludeLaunchDescription(
        PythonLaunchDescriptionSource(
            os.path.join(slam_dir, 'launch', 'online_async_launch.py')
        ),
        launch_arguments={
            'slam_params_file': slam_params_file,
            'use_sim_time': use_sim_time
        }.items()
    )

    scan_corrector_node = Node(
        package='scan_corrector',
        executable='scan_corrector_node',
        name='scan_corrector_node',
        output='screen',
        parameters=[],
        remappings=[
            ('/scan', '/scan'),  # entrée
            ('/scan_filtered', '/scan_filtered')  # sortie
        ]
    )

    limo_cartographer = IncludeLaunchDescription(
        PythonLaunchDescriptionSource(
            os.path.join(bringup_dir, 'launch/humble', 'limo_cartographer.launch.py')
        )
    )


    # === 2️⃣ Lancement de Nav2 ===
    nav2_params = os.path.join(nav2_dir, 'params', 'nav2_params.yaml')
    nav2_launch = IncludeLaunchDescription(
        PythonLaunchDescriptionSource(
            os.path.join(nav2_dir, 'launch', 'bringup_launch.py')
        ),
        launch_arguments={
            'params_file': nav2_params,
            'use_sim_time': use_sim_time,
            'map':''
        }.items()
    )


    # === 3️⃣ Lancement du nœud d’exploration autonome ===
    exploration_node = Node(
        package='exploration_pkg',
        executable='frontier_explorer',
        name='frontier_explorer',
        output='screen',
        parameters=[{
            'use_sim_time': use_sim_time,
            'map_topic': '/map',
            'odom_topic': '/odometry/filtered',
            'base_frame': 'base_link',
            'frontier_visualization': True
        }]
    )

    # === 4️⃣ RViz (optionnel, pratique pour tester) ===
    rviz_config = os.path.join(bringup_dir, 'rviz', 'exploration.rviz')
    rviz = Node(
        package='rviz2',
        executable='rviz2',
        name='rviz2',
        arguments=['-d', rviz_config],
        output='screen'
    )

    return LaunchDescription(declared_arguments + [
        GroupAction([
            #slam_toolbox,
            nav2_launch,
            #exploration_node,
            rviz,
            #scan_corrector_node,
            #limo_cartographer,
        ])
    ])
